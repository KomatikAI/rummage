# PayPal environment. The app refuses to start unless this is "sandbox".
PAYPAL_ENV=sandbox
# PayPal sandbox REST app client ID (server side).
PAYPAL_CLIENT_ID=
# PayPal sandbox REST app client secret (server side only, never expose to the browser).
PAYPAL_CLIENT_SECRET=
# PayPal partner attribution (BN) code sent as the PayPal-Partner-Attribution-Id header.
PAYPAL_BN_CODE=
# PayPal merchant ID of the partner (platform) account used for Partner Referrals.
PAYPAL_PARTNER_MERCHANT_ID=
# Webhook ID from the PayPal developer dashboard, used to verify webhook signatures.
PAYPAL_WEBHOOK_ID=
# PayPal sandbox client ID exposed to the browser for the JS SDK buttons.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (publishable) key, safe for the browser with RLS on every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key (server side only, bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=
# Anthropic API key for photo pricing and the assistants (server side only).
ANTHROPIC_API_KEY=
# Public base URL of this deployment, used for PayPal return and cancel URLs.
APP_URL=
